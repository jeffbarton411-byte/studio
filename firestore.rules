/**
 * Security Rules for drive4mmm
 * 
 * Philosophy:
 * 1. Public Read Access: Anyone with a tracking ID can view the status of an application.
 * 2. Admin Write: Client-side writes are blocked. All submissions and status updates 
 *    occur via Server Actions using the Firebase Admin SDK for maximum security.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Publicly accessible applications. 
     * @path /applications/{applicationId}
     * @allow (get, list) Anyone can read application data.
     * @deny (write) No client-side modifications allowed.
     */
    match /applications/{applicationId} {
      allow read: if true;
      allow write: if false;
    }
    
    /**
     * @description Legacy/System paths.
     */
    match /test_connections/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
