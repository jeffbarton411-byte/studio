{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "Represents a carrier application for drive4mmm.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique tracking ID (e.g., MMM-123456-ABCD)."
        },
        "companyName": {
          "type": "string",
          "description": "Dispatch company name."
        },
        "carrierFullName": {
          "type": "string"
        },
        "carrierCompanyName": {
          "type": "string"
        },
        "mcNumber": {
          "type": "string"
        },
        "dotNumber": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paymentMethod": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "In Progress",
            "Completed",
            "Rejected",
            "Deleted"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "mcNumber",
        "dotNumber",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/applications/{applicationId}": {
      "schema": "#/backend/entities/Application",
      "description": "Publicly readable applications for the tracking portal and admin panel."
    }
  }
}
